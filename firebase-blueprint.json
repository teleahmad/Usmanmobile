{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store mobile accessory or device for sale",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "maxLength": 40 },
        "shopItemKey": { "type": "string", "maxLength": 60 },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "pricePkr": { "type": "number" },
        "originalPricePkr": { "type": "number" },
        "discountPercent": { "type": "number" },
        "rating": { "type": "string", "maxLength": 10 },
        "reviewsCount": { "type": "number" },
        "soldCount": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "maxLength": 40 },
        "inStock": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "specs": { "type": "string", "maxLength": 240 },
        "description": { "type": "string", "maxLength": 1000 },
        "warrantyNote": { "type": "string", "maxLength": 120 },
        "image": { "type": "string", "maxLength": 350000 },
        "variants": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "pricePkr", "inStock"]
    },
    "UsedPhone": {
      "title": "UsedPhone",
      "description": "Pre-owned or second-hand smartphone available at Usman Mobile Repairing Centre",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 40 },
        "pricePkr": { "type": "number" },
        "marketPricePkr": { "type": "number" },
        "storage": { "type": "string", "maxLength": 40 },
        "condition": { "type": "string", "maxLength": 40 },
        "ptaStatus": {
          "type": "string",
          "enum": ["PTA Approved", "Non-PTA", "JV / Patch", "Official Warranty"],
          "maxLength": 30
        },
        "batteryHealth": { "type": "string", "maxLength": 40 },
        "accessories": { "type": "string", "maxLength": 80 },
        "warrantyNote": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 600 },
        "photos": { "type": "array" },
        "available": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "brand", "pricePkr", "storage", "condition", "ptaStatus", "available"]
    },
    "CustomerReview": {
      "title": "CustomerReview",
      "description": "Public customer rating and review with privacy-masked last 4 phone digits only",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "maxLength": 60 },
        "maskedPhone": { "type": "string", "maxLength": 20 },
        "rating": { "type": "number" },
        "service": { "type": "string", "maxLength": 60 },
        "comment": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "maskedPhone", "rating", "comment", "createdAt", "updatedAt"]
    },
    "ReviewKey": {
      "title": "ReviewKey",
      "description": "Private non-readable phone hash proof allowing customers to edit only their own review",
      "type": "object",
      "properties": {
        "phoneHash": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["phoneHash", "updatedAt"]
    },
    "SiteMedia": {
      "title": "SiteMedia",
      "description": "Customizable shop interior, exterior, signboard, and hero images",
      "type": "object",
      "properties": {
        "slotKey": { "type": "string", "maxLength": 60 },
        "title": { "type": "string", "maxLength": 120 },
        "caption": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string", "maxLength": 350000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slotKey", "imageUrl"]
    },
    "SocialLinks": {
      "title": "SocialLinks",
      "description": "Shop social media profile URLs managed by admin for footer buttons",
      "type": "object",
      "properties": {
        "tiktok": { "type": "string", "maxLength": 300 },
        "youtube": { "type": "string", "maxLength": 300 },
        "facebook": { "type": "string", "maxLength": 300 },
        "instagram": { "type": "string", "maxLength": 300 },
        "x": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
      }
    },
    "RepairTicket": {
      "title": "RepairTicket",
      "description": "Customer mobile repair job ticket and tracking status",
      "type": "object",
      "properties": {
        "token": { "type": "string", "maxLength": 30 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "deviceModel": { "type": "string", "maxLength": 100 },
        "issue": { "type": "string", "maxLength": 300 },
        "costPkr": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["received", "in_progress", "ready", "delivered"],
          "maxLength": 20
        },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "customerName", "customerPhone", "deviceModel", "issue", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Online customer shopping cart order",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 30 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerAddress": { "type": "string", "maxLength": 300 },
        "itemsSummary": { "type": "string", "maxLength": 1000 },
        "totalPkr": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["new", "confirmed", "dispatched", "completed", "cancelled"],
          "maxLength": 20
        },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "totalPkr", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Retail catalog products list with admin overrides and additions"
    },
    "/usedPhones/{phoneId}": {
      "schema": "UsedPhone",
      "description": "Second-hand / used smartphones inventory managed by admin"
    },
    "/reviews/{reviewId}": {
      "schema": "CustomerReview",
      "description": "Public customer reviews with privacy-masked phone last 4 digits"
    },
    "/reviewKeys/{reviewId}": {
      "schema": "ReviewKey",
      "description": "Private hashed ownership proof for customer self-editing of reviews"
    },
    "/siteMedia/{slotId}": {
      "schema": "SiteMedia",
      "description": "Shop interior, storefront, signboard, and gallery photos managed by admin"
    },
    "/siteSettings/{settingId}": {
      "schema": "SocialLinks",
      "description": "Shop social media links (TikTok, YouTube, Facebook, Instagram, X) managed by admin"
    },
    "/repairs/{repairId}": {
      "schema": "RepairTicket",
      "description": "Mobile repair orders and progress status"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Whitelisted administrator accounts"
    }
  }
}
